### GraphQL User API Tests ###
@baseUrl = http://localhost:3000
@authToken = dev-token-003

### Mutation - Firebase Authentication login/create
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation { firebaseAuth { success user { id email firebase_uid first_name last_name role status } errors { field message } } }"
}

### Mutation - update User Profile
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation($input: UpdateUserInput!) { updateUser(input: $input) { success user { id first_name last_name username gender dob bio status primary_goal secondary_goal } errors { field message } } }",
  "variables": {
    "input": {
      "first_name": "John",
      "last_name": "Doe",
      "username": "johndoe",
      "gender": "male",
      "bio": "hi i'm john",
      "primary_goal": "RISE_AND_SHINE",
      "secondary_goal": "STUDYING_WORKING",
      "dob": "2000-01-25",
      "status": "active"
    }
  }
}

### Mutation - update User 2 Profile
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation($input: UpdateUserInput!) { updateUser(input: $input) { success user { id first_name last_name username gender dob status } errors { field message } } }",
  "variables": {
    "input": {
      "first_name": "Jane",
      "last_name": "Smith",
      "username": "janesmith",
      "gender": "female",
      "bio": "hi i'm jane",
      "primary_goal": "WORKING_OUT",
      "secondary_goal": "PASSION_HOBBY",
      "dob": "2024-01-11",
      "status": "active"
    }
  }
}

### Mutation - update User 3 Profile
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation($input: UpdateUserInput!) { updateUser(input: $input) { success user { id first_name last_name username gender dob status } errors { field message } } }",
  "variables": {
    "input": {
      "first_name": "Sally",
      "last_name": "Park",
      "username": "SallyPark",
      "gender": "female",
      "bio": "hi i'm sally",
      "primary_goal": "FOOD",
      "secondary_goal": "WELLNESS",
      "dob": "2024-01-18",
      "status": "active"
    }
  }
}

### Mutation - Delete User (Admin Only)
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation($id: Int!) { deleteUser(id: $id) { success errors { field message } } }",
  "variables": {
    "id": 3
  }
}


### GraphQL Friend Request API Tests ###

### Mutation - Create Friend Request
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($input: CreateFriendshipInput!) { createFriendship(input: $input) { success friendship { user {id first_name last_name } friend {id first_name last_name } status } errors { field message } } }",
  "variables": {
    "input": {
      "sender_id": 2,
      "receiver_id": 3
    }
  }
}

### Mutation - Update Friend Request
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($userId: Int!, $friendId: Int!, $input: UpdateFriendshipInput!) { updateFriendship(user_id: $userId, friend_id: $friendId, input: $input) { success friendship { user {id first_name last_name } friend {id first_name last_name } status } errors { field message } } }",
  "variables": {
    "userId": 3,
    "friendId": 2,
    "input": {
      "status": "ACCEPTED"
    }
  }
}

### Mutation - Delete Friend
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation($userId: Int!, $friendId: Int!) { deleteFriendship(user_id: $userId, friend_id: $friendId) { success errors { field message } } }",
  "variables": {
    "userId": 1,
    "friendId": 3
  }
}


### GraphQL Community API Tests ###

### Mutation - Create Community
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($input: CreateCommunityInput!) { createCommunity(input: $input) { success community { id name description thumbnail influencer { id first_name last_name email } } errors { field message } } }",
  "variables": {
    "input": {
      "name": "John's Community",
      "influencer_id": 1
    }
  }
}



### Mutation - Update Community
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($id: Int!, $input: UpdateCommunityInput!) { updateCommunity(id: $id, input: $input) { success community { id name description thumbnail influencer { id first_name last_name email } } errors { field message } } }",
  "variables": {
    "id": 1,
    "input": {
      "name": "community but with updated description",
      "description": "new description"
    }
  }
}

### Mutation - Delete Community
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation($id: Int!) { deleteCommunity(id: $id) { success errors { field message } } }",
  "variables": {
    "id": 2
  }
}

### GraphQL Community Category API Tests ###

### Mutation - Create Community Category
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($input: CreateCommunityCategoryInput!) { createCommunityCategory(input: $input) { success community_category { community { id name influencer { id first_name last_name } } category } errors { field message } } }",
  "variables": {
    "input": {
      "community_id": 2,
      "category": "PASSION_HOBBY"
    }
  }
}

### Mutation - Delete Community Category
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation($community_id: Int!, $category: Category!) { deleteCommunityCategory(community_id: $community_id, category: $category) { success errors { field message } } }",
  "variables": {
    "community_id": 3,
    "category": "FOOD"
  }
}


### GraphQL Community Member API Tests ###

### Mutation - Create Community Member
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($input: CreateCommunityMemberInput!) { createCommunityMember(input: $input) { success community_member { community { id name influencer { id first_name last_name } } user { id first_name last_name } role status } errors { field message } } }",
  "variables": {
    "input": {
      "community_id": 1,
      "user_id": 2
    }
  }
}

### Mutation - Update community member role/status
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($communityId: Int!, $userId: Int!, $input: UpdateCommunityMemberInput!) { updateCommunityMember(community_id: $communityId, user_id: $userId, input: $input) { success community_member { community { id name influencer { id first_name last_name } } user { id first_name last_name } role status } errors { field message } } }",
  "variables": {
    "communityId": 1,
    "userId": 2,
    "input": {
      "status": "ACCEPTED"
    }
  }
}

### Mutation - Delete member from community
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($userId: Int!, $communityId: Int!) { deleteCommunityMember(user_id: $userId, community_id: $communityId) { success errors { field message } } }",  
  "variables": {
    "communityId": 1,
    "userId": 3
  }
}


### GraphQL Chat API Tests ###

### Mutation - Create Chat
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($input: CreateChatInput!) { createChat(input: $input) { success chat { id type title password profile_pic creator { id first_name last_name email } } errors { field message } } }",
  "variables": {
    "input": {
      "type": "group",
      "title": "John's Group Chat",
      "creator_id": 1
    }
  }
}


### Mutation - Update Chat
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($id: Int!, $input: UpdateChatInput!) { updateChat(id: $id, input: $input) { success chat { id type title password profile_pic creator { id first_name last_name email } } errors { field message } } }",
  "variables": {
    "id": 1,
    "input": {
      "title": "John's Group Chat",
      "password": "secret password",
      "profile_pic": "some image"
    }
  }
}

### Mutation - Delete Chat
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation($id: Int!) { deleteChat(id: $id) { success errors { field message } } }",
  "variables": {
    "id": 1
  }
}



### GraphQL Chat Member API Tests ###

### Mutation - Create Chat Member
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($input: CreateChatMemberInput!) { createChatMember(input: $input) { success chat_member { chat { id type title creator { id first_name last_name email } } user { id first_name last_name email } role status } errors { field message } } }",
  "variables": {
    "input": {
      "chat_id": 2,
      "user_id": 4,
      "status": "ACCEPTED"
    }
  }
}

### Mutation - Update chat member role/status
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($chatId: Int!, $userId: Int!, $input: UpdateChatMemberInput!) { updateChatMember(chat_id: $chatId, user_id: $userId, input: $input) { success chat_member { chat { id type title creator { id first_name last_name email } } user { id first_name last_name email } role status } errors { field message } } }",
  "variables": {
    "chatId": 1,
    "userId": 2,
    "input": {
      "status": "ACCEPTED"
    }
  }
}

### Mutation - Delete member from chat
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($userId: Int!, $chatId: Int!) { deleteChatMember(user_id: $userId, chat_id: $chatId) { success errors { field message } } }",  
  "variables": {
    "chatId": 6,
    "userId": 3
  }
}

### GraphQL Chat Member API Tests ###

### Mutation - Create a Message
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($input: CreateMessageInput!){ createMessage(input: $input) { success message { id chat { id title } sender { id first_name last_name } content post { id caption } created_at } errors { field message } } }",  
  "variables": {
    "input": {
      "chat_id": 2,
      "sender_id": 1,
      "content": "Hello World"
    }
  }
}

### GraphQL Point + Redeem API Tests ###

### Mutation - Update Point
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($id: Int!, $input: UpdatePointInput!){ updatePoint(id: $id, input: $input) { success point { user { id first_name last_name } points spending_points weekly_points monthly_points } errors { field message } } }",  
  "variables": {
    "id": 2,
    "input": {
      "points_added": 500
    }
  }
}

### Mutation - Create a Redeem
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($input: CreateRedeemInput!){ createRedeem(input: $input) { success redeem { user { id first_name last_name } reward { id title required_points } points_spent status  } errors { field message } } }",  
  "variables": {
    "input": {
      "user_id": 1,
      "reward_id": 1
    }
  }
}

### Mutation - Update a Redeem
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($id: Int!, $input: UpdateRedeemInput!){ updateRedeem(id: $id, input: $input) { success redeem { id user { id first_name last_name } reward { id title description required_points } points_spent status } errors { field message } } }",  
  "variables": {
    "id": 3,
    "input": {
      "status": "ACCEPTED"
    }
  }
}

### Mutation - Delete a Redeem
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($id: Int!){ deleteRedeem(id: $id) { success errors { field message } } }",  
  "variables": {
    "id": 3
  }
}

### GraphQL Reward API Tests ###

### Mutation - Create a Reward
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($input: CreateRewardInput!){ createReward(input: $input) { success reward { id title description required_points } errors { field message } } }",  
  "variables": {
    "input": {
      "title": "test reward",
      "description": "you lose a 100 points",
      "required_points": 100
    }
  }
}


### Mutation - Update a Reward
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($id: Int!, $input: UpdateRewardInput!){ updateReward(id: $id, input: $input) { success reward { id title description required_points } errors { field message } } }",  
  "variables": {
    "id": 1,
    "input": {
      "description": "$15",
      "required_points": 10000
    }
  }
}

### Mutation - Delete a Reward
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($id: Int!){ deleteReward(id: $id) { success errors { field message } } }",  
  "variables": {
    "id": 1
  }
}