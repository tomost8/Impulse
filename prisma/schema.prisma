generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Category {
  FOOD
  WELLNESS
  WORKING_OUT
  STUDYING_WORKING
  RISE_AND_SHINE
  PASSION_HOBBY
}

enum Role {
  ADMIN
  USER
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Notification System Models
enum NotificationType {
  ADMIN_BROADCAST    // 管理员全局广播
  COMMUNITY_NOTICE   // 社区通知
  GROUP_NOTICE      // 群组通知
  REMINDER          // 个人提醒
}

enum NotificationStatus {
  PENDING    // 待发送
  SENT      // 已发送
  FAILED    // 发送失败
  READ      // 已读
}

enum NotificationScheduleType {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

// 示例模型
model User {
  id              Int       @id @default(autoincrement()) @map("user_id")
  email           String    @unique
  firebase_uid    String    @unique
  first_name      String?
  last_name       String?
  username        String?
  dob             DateTime? @db.Date
  gender          String?
  profile_picture String?
  role            String    @default("user")
  status          String    @default("pending")
  timezone        String?
  searchable      Boolean   @default(true)
  fcm_token       String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now()) @updatedAt
  last_login_at   DateTime?

  friendships_sent      Friendship[]      @relation("FriendsSent")
  friendships_received  Friendship[]      @relation("FriendsReceived")
  communities_owned     Community[]
  community_memberships CommunityMember[]
  chats_created         Chat[]
  chat_memberships      ChatMember[]
  activities          Activity[]
  messages              Message[]
  posts                 Post[]
  post_views            PostView[]
  points                Point[]
  redeems               Redeem[]
  notifications_sent     Notification[]          @relation("NotificationSender")
  notification_received  NotificationRecipient[]

  @@index([username])
  @@map("users")
}

model Friendship {
  id          Int           @id @default(autoincrement())
  sender      User          @relation("FriendsSent", fields: [sender_id], references: [id], onDelete: Cascade)
  sender_id   Int
  receiver    User          @relation("FriendsReceived", fields: [receiver_id], references: [id], onDelete: Cascade)
  receiver_id Int
  status      RequestStatus @default(PENDING)
  chat        Chat?         @relation(fields: [chat_id], references: [id])
  chat_id     Int?
  created_at  DateTime      @default(now())
  updated_at  DateTime      @default(now()) @updatedAt

  @@unique([sender_id, receiver_id])
  @@map("friendships")
}

model Community {
  id            Int      @id @default(autoincrement()) @map("community_id")
  name          String
  description   String?
  thumbnail     String?
  influencer    User     @relation(fields: [influencer_id], references: [id])
  influencer_id Int
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  community_categories CommunityCategory[]
  community_members    CommunityMember[]

  @@map("communities")
}

model CommunityCategory {
  id           Int       @id @default(autoincrement())
  community    Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  community_id Int
  category     Category

  @@unique([community_id, category])
  @@map("community_categories")
}

model CommunityMember {
  id           Int           @id @default(autoincrement())
  community    Community     @relation(fields: [community_id], references: [id], onDelete: Cascade)
  community_id Int
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id      Int
  role         Role          @default(USER)
  status       RequestStatus @default(ACCEPTED)
  joined_at    DateTime      @default(now())
  groupId      Int?

  @@unique([community_id, user_id])
  @@map("community_members")
}

model Chat {
  id          Int      @id @default(autoincrement()) @map("chat_id")
  type        String
  title       String?
  password    String?
  profile_pic String?
  creator     User     @relation(fields: [creator_id], references: [id])
  creator_id  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  chat_members ChatMember[]
  messages     Message[]
  direct_chats Friendship[]

  @@map("chats")
}

model ChatMember {
  id        Int           @id @default(autoincrement())
  chat      Chat          @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  chat_id   Int
  user      User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id   Int
  role      Role          @default(USER)
  status    RequestStatus @default(PENDING)
  joined_at DateTime      @default(now())

  @@unique([chat_id, user_id])
  @@map("chat_members")
}

model Message {
  id         Int      @id @default(autoincrement()) @map("message_id")
  chat       Chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  chat_id    Int
  sender     User     @relation(fields: [sender_id], references: [id], onDelete: Cascade)
  sender_id  Int
  content    String?
  post       Post?    @relation(fields: [post_id], references: [id])
  post_id    Int?
  created_at DateTime @default(now())

  @@index([chat_id, created_at])
  @@map("messages")
}

//activity
model Activity {
  id                Int       @id @default(autoincrement())
  name              String?
  description       String?
  category          String
  duration          Int?
  scheduledDatetime DateTime? @map("scheduled_datetime")
  status            String    @default("pending")
  post              Post?     @relation(fields: [postId], references: [id])
  postId            Int?      @unique @map("post_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  user              User      @relation(fields: [userId], references: [id])
  userId            Int       @map("user_id")

  @@index([scheduledDatetime])
  @@index([userId, scheduledDatetime])
  @@map("activities")
}

model Post {
  id          Int          @id @default(autoincrement())
  author      User         @relation(fields: [author_id], references: [id])
  author_id   Int
  caption     String?
  mediaUrl   String?      @map("media_url")
  is_deleted  Boolean      @default(false)
  activity    Activity?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  expires_at  DateTime?    // story类型设置24小时，chat类型为null
  post_targets PostTarget[]
  post_views   PostView[]
  Message      Message[]
  category    String?

  @@index([author_id, created_at])
  @@index([expires_at, is_deleted])
  @@map("posts")
}

model PostTarget {
  id          Int      @id @default(autoincrement())
  post        Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id     Int
  target_type String // 'community', 'chat', 'group'
  target_id   Int
  created_at  DateTime @default(now())

  @@unique([post_id, target_type, target_id])
  @@index([target_type, target_id])
  @@map("post_targets")
}

model PostView {
  id        Int      @id @default(autoincrement())
  post      Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id   Int
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id   Int
  viewed_at DateTime @default(now())

  @@unique([post_id, user_id])
  @@index([user_id, viewed_at])
  @@map("post_views")
}

model Point {
  //id                Int       @id @default(autoincrement())
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id           Int       @id @unique
  points            Int       @default(0)
  spending_points   Int       @default(0)
  weekly_points     Int       @default(0)
  monthly_points    Int       @default(0)
  status            String    @default("active")
  preferences       Json?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  weekly_update_at  DateTime?
  monthly_update_at DateTime?

  @@map("points")
}

model Reward {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  required_points Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  redeems         Redeem[]

  @@map("rewards")
}

model Redeem {
  id              Int           @id @default(autoincrement())
  user            User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id         Int
  reward          Reward        @relation(fields: [reward_id], references: [id], onDelete: Cascade)
  reward_id       Int
  points_spent    Int
  status          RequestStatus @default(PENDING)
  payment_details Json?
  processing_time DateTime?
  notes           String?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  @@map("redeems")
}

model Notification {
  id          Int               @id @default(autoincrement())
  type        NotificationType
  title       String
  content     String
  sender      User              @relation("NotificationSender", fields: [sender_id], references: [id])
  sender_id   Int
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  
  // 用于社区/群组通知
  community_id Int?
  group_id    Int?
  
  // 用于定时提醒
  schedule_type NotificationScheduleType?       
  schedule_time DateTime?      // 计划发送时间
  last_sent    DateTime?      // 最后一次发送时间
  is_active    Boolean        @default(true)
  
  // 通知接收记录
  recipients   NotificationRecipient[]

  @@index([sender_id])
  @@index([type])
  @@index([schedule_time, is_active])
  @@index([community_id])
  @@index([group_id])
  @@map("notifications")
}

model NotificationRecipient {
  id              Int               @id @default(autoincrement())
  notification    Notification      @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  notification_id Int
  recipient       User              @relation(fields: [recipient_id], references: [id], onDelete: Cascade)
  recipient_id    Int
  status          NotificationStatus @default(PENDING)
  sent_at         DateTime?
  read_at         DateTime?
  error_message   String?

  @@unique([notification_id, recipient_id])
  @@index([recipient_id, status])
  @@index([notification_id, status])
  @@map("notification_recipients")
}
