// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// Prisma Error Reference
// https://www.prisma.io/docs/reference/api-reference/error-reference

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Category {
  FOOD
  WELLNESS
  WORKING_OUT
  STUDYING_WORKING
  RISE_AND_SHINE
  PASSION_HOBBY
}

enum Role {
  ADMIN
  USER
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum UserSortType {
  POINTS_WEEKLY
  POINTS_MONTHLY
  POINTS_ALL
}

// Notification System Models
enum NotificationType {
  ADMIN_BROADCAST // 管理员全局广播
  COMMUNITY_NOTICE // 社区通知
  GROUP_NOTICE // 群组通知
  REMINDER // 个人提醒
}

enum NotificationStatus {
  PENDING // 待发送
  SENT // 已发送
  FAILED // 发送失败
  READ // 已读
}

enum NotificationScheduleType {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

enum ChallengeLength {
  DAYS_7
  DAYS_14
  DAYS_21
}

enum BadgeLevel {
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

enum ChallengeStatus {
  NOT_STARTED
  ACTIVE
  COMPLETED
  FAILED
}

// 示例模型
model User {
  id              Int       @id @default(autoincrement()) @map("user_id")
  email           String    @unique
  firebase_uid    String    @unique
  first_name      String?
  last_name       String?
  username        String?
  dob             DateTime? @db.Date
  age             Int?
  gender          String?
  profile_picture String?
  bio             String?
  role            String    @default("USER")
  status          String    @default("pending")
  primary_goal    Category?
  secondary_goal  Category?
  timezone        String?
  searchable      Boolean   @default(true)
  is_double_cam   Boolean   @default(false)
  fcm_token       String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now()) @updatedAt
  last_login_at   DateTime?
  referral_code   String?   @unique

  friendships_with      Friendship[]            @relation("FriendsWith")
  friendships_of        Friendship[]            @relation("FriendsOf")
  communities_owned     Community[]
  community_memberships CommunityMember[]
  chats_created         Chat[]
  chat_memberships      ChatMember[]
  activities            Activity[]
  messages              Message[]
  posts                 Post[]
  post_views            PostView[]
  point                 Point?
  redeems               Redeem[]
  notifications_sent    Notification[]          @relation("NotificationSender")
  notification_received NotificationRecipient[]
  comments              Comment[]
  likes                 Like[]
  login_streak          UserLoginStreak?
  user_challenges       UserChallenge[]
  badges                Badge[]
  referrals_made        Referral[]              @relation("ReferredBy")
  referred              Referral?               @relation("ReferredUser")

  @@index([username])
  @@map("users")
}

model UserLoginStreak {
  id               Int      @id @default(autoincrement())
  user_id          Int
  last_login_date  DateTime
  streak_count     Int      @default(0)
  max_streak_count Int      @default(0)
  weekly_logins    Json     @default("[]")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id])
  @@map("user_login_streaks")
}

model Friendship {
  id         Int           @id @default(autoincrement())
  user       User          @relation("FriendsWith", fields: [user_id], references: [id], onDelete: Cascade)
  user_id    Int
  friend     User          @relation("FriendsOf", fields: [friend_id], references: [id], onDelete: Cascade)
  friend_id  Int
  status     RequestStatus @default(PENDING)
  role       String?
  chat       Chat?         @relation(fields: [chat_id], references: [id])
  chat_id    Int?
  created_at DateTime      @default(now())
  updated_at DateTime      @default(now()) @updatedAt

  @@unique([user_id, friend_id])
  @@map("friendships")
}

model Community {
  id            Int      @id @default(autoincrement()) @map("community_id")
  name          String
  code          String?  @unique
  description   String?
  thumbnail     String?
  influencer    User     @relation(fields: [influencer_id], references: [id])
  influencer_id Int
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  community_categories CommunityCategory[]
  community_members    CommunityMember[]

  @@map("communities")
}

model CommunityCategory {
  id           Int       @id @default(autoincrement())
  community    Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  community_id Int
  category     Category

  @@unique([community_id, category])
  @@map("community_categories")
}

model CommunityMember {
  id           Int           @id @default(autoincrement())
  community    Community     @relation(fields: [community_id], references: [id], onDelete: Cascade)
  community_id Int
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id      Int
  role         Role          @default(USER)
  status       RequestStatus @default(ACCEPTED)
  joined_at    DateTime      @default(now())
  groupId      Int?

  @@unique([community_id, user_id])
  @@map("community_members")
}

model Chat {
  id          Int      @id @default(autoincrement()) @map("chat_id")
  type        String
  title       String?
  password    String?
  profile_pic String?
  creator     User?    @relation(fields: [creator_id], references: [id])
  creator_id  Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  chat_members ChatMember[]
  messages     Message[]
  direct_chats Friendship[]

  @@map("chats")
}

model ChatMember {
  id        Int           @id @default(autoincrement())
  chat      Chat          @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  chat_id   Int
  user      User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id   Int
  role      Role          @default(USER)
  status    RequestStatus @default(PENDING)
  joined_at DateTime      @default(now())

  @@unique([chat_id, user_id])
  @@map("chat_members")
}

model Message {
  id         Int      @id @default(autoincrement()) @map("message_id")
  chat       Chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  chat_id    Int
  sender     User     @relation(fields: [sender_id], references: [id], onDelete: Cascade)
  sender_id  Int
  content    String?
  post       Post?    @relation(fields: [post_id], references: [id])
  post_id    Int?
  created_at DateTime @default(now())

  @@index([chat_id, created_at])
  @@map("messages")
}

//activity
model Activity {
  id                Int       @id @default(autoincrement())
  name              String?
  description       String?
  category          String
  duration          Int?
  scheduledDatetime DateTime? @map("scheduled_datetime")
  status            String    @default("pending")
  post              Post?     @relation(fields: [postId], references: [id])
  postId            Int?      @unique @map("post_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  user              User      @relation(fields: [userId], references: [id])
  userId            Int       @map("user_id")

  @@index([scheduledDatetime])
  @@index([userId, scheduledDatetime])
  @@map("activities")
}

model Post {
  id           Int          @id @default(autoincrement())
  author       User         @relation(fields: [author_id], references: [id])
  author_id    Int
  caption      String?
  mediaUrls    String[]     @default([]) @map("media_urls")
  is_deleted   Boolean      @default(false)
  activity     Activity?
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt
  expires_at   DateTime? // story类型设置24小时，chat类型为null
  post_targets PostTarget[]
  post_views   PostView[]
  Message      Message[]
  category     String?
  comments     Comment[]
  likes        Like[]
  like_count   Int          @default(0)

  challenge_day_entries ChallengeDayEntry[]

  @@index([author_id, created_at])
  @@index([expires_at, is_deleted])
  @@index([created_at, expires_at])
  @@map("posts")
}

model PostTarget {
  id          Int      @id @default(autoincrement())
  post        Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id     Int
  target_type String // 'community', 'chat', 'group'
  target_id   Int
  created_at  DateTime @default(now())

  @@unique([post_id, target_type, target_id])
  @@index([target_type, target_id])
  @@map("post_targets")
}

model PostView {
  id        Int      @id @default(autoincrement())
  post      Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id   Int
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id   Int
  viewed_at DateTime @default(now())

  @@unique([post_id, user_id])
  @@index([user_id, viewed_at])
  @@map("post_views")
}

model Point {
  //id                Int       @id @default(autoincrement())
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id           Int       @id @unique
  points            Int       @default(0)
  spending_points   Int       @default(0)
  weekly_points     Int       @default(0)
  monthly_points    Int       @default(0)
  status            String    @default("active")
  preferences       Json?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  weekly_update_at  DateTime?
  monthly_update_at DateTime?

  @@map("points")
}

model Reward {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  required_points Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  redeems         Redeem[]

  @@map("rewards")
}

model Redeem {
  id              Int           @id @default(autoincrement())
  user            User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id         Int
  reward          Reward        @relation(fields: [reward_id], references: [id], onDelete: Cascade)
  reward_id       Int
  points_spent    Int
  status          RequestStatus @default(PENDING)
  payment_details Json?
  processing_time DateTime?
  notes           String?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  @@map("redeems")
}

model Notification {
  id         Int              @id @default(autoincrement())
  type       NotificationType
  title      String
  content    String
  sender     User             @relation("NotificationSender", fields: [sender_id], references: [id])
  sender_id  Int
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt

  // 用于社区/群组通知
  community_id Int?
  group_id     Int?

  // 用于定时提醒
  schedule_type NotificationScheduleType?
  schedule_time DateTime? // 计划发送时间
  last_sent     DateTime? // 最后一次发送时间
  is_active     Boolean                   @default(true)

  // 通知接收记录
  recipients NotificationRecipient[]

  @@index([sender_id])
  @@index([type])
  @@index([schedule_time, is_active])
  @@index([community_id])
  @@index([group_id])
  @@map("notifications")
}

model NotificationRecipient {
  id              Int                @id @default(autoincrement())
  notification    Notification       @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  notification_id Int
  recipient       User               @relation(fields: [recipient_id], references: [id], onDelete: Cascade)
  recipient_id    Int
  status          NotificationStatus @default(PENDING)
  sent_at         DateTime?
  read_at         DateTime?
  error_message   String?

  @@unique([notification_id, recipient_id])
  @@index([recipient_id, status])
  @@index([notification_id, status])
  @@map("notification_recipients")
}

model Like {
  id         Int      @id @default(autoincrement())
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    Int
  created_at DateTime @default(now())

  @@unique([post_id, user_id])
  @@index([post_id])
}

model Comment {
  id                Int       @id @default(autoincrement())
  post              Post      @relation(fields: [post_id], references: [id], onDelete: Cascade) // 对应的Post
  post_id           Int
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade) // 评论用户
  user_id           Int
  parent_comment    Comment?  @relation("ParentComment", fields: [parent_comment_id], references: [id], onDelete: Cascade) // 父评论
  parent_comment_id Int? // 如果是回复其他评论，则此字段指向父评论ID
  content           String // 评论内容
  created_at        DateTime  @default(now()) // 创建时间
  updated_at        DateTime  @default(now()) @updatedAt // 更新时间
  replies           Comment[] @relation("ParentComment") // 子评论（回复）

  @@index([post_id, created_at]) // 根据Post和时间进行索引
  @@index([user_id]) // 根据User进行索引
  @@map("comments")
}

// Static Master List of All Possible Challenges
model Challenge {
  id             Int            @id @default(autoincrement())
  category       Category
  length         ChallengeLength    // 7, 14, or 21 days
  title          String             // e.g. "7 Day Wellness Challenge"
  description    String?
  points_bronze  Int
  points_silver  Int
  points_gold    Int
  points_diamond Int

  // Relations
  userChallenges UserChallenge[]
  badges         Badge[]

  @@unique([category, length])
}

// A user's attempt at a challenge (active or completed)
model UserChallenge {
  id             Int          @id @default(autoincrement())
  user           User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id        Int
  challenge      Challenge    @relation(fields: [challenge_id], references: [id])
  challenge_id   Int
  started_at     DateTime
  ends_at        DateTime
  completed_at   DateTime?
  status         ChallengeStatus @default(NOT_STARTED)
  days_completed Int          // How many days they've completed so far
  badge_level    BadgeLevel?  // Set at completion if earned, otherwise null

  // Relations
  challenge_day_entries ChallengeDayEntry[]
  badges                Badge[]

  @@unique([user_id, challenge_id, started_at]) // allow multiple attempts at same challenge, but not overlapping
}

// Each day the user can get credit for at most 1 pic/progress for this category+challenge
model ChallengeDayEntry {
  id                Int           @id @default(autoincrement())
  user_challenge    UserChallenge @relation(fields: [user_challenge_id], references: [id], onDelete: Cascade)
  user_challenge_id Int
  day_number        Int           // 1-indexed, e.g. 1..7 for 7-day challenge
  date              DateTime      // The date this day was credited (localtime)
  post             Post?         @relation(fields: [post_id], references: [id])
  post_id           Int?          // The POST (picture) that counts for this day, if stored
  
  @@unique([user_challenge_id, day_number])
}

// Record of actual badge(s) a user has earned (historical: can earn same badge multiple times )
model Badge {
  id                Int        @id @default(autoincrement())
  user              User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id           Int
  challenge         Challenge  @relation(fields: [challenge_id], references: [id])
  challenge_id      Int
  badge_level       BadgeLevel
  earned_at         DateTime
  days_completed    Int
  user_challenge_id Int?

  userChallenge    UserChallenge? @relation(fields: [user_challenge_id], references: [id])
}

model Referral {
  id           Int      @id @default(autoincrement())
  referrer_id  Int
  referee_id   Int      @unique // A user can only be referred once
  status       String   @default("pending") // e.g., "pending", "completed"
  created_at   DateTime @default(now())
  completed_at DateTime?

  referrer User @relation("ReferredBy", fields: [referrer_id], references: [id])
  referee  User @relation("ReferredUser", fields: [referee_id], references: [id])

  @@map("referrals")
}