generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 示例模型
model User {
  id                    Int                @id @default(autoincrement())
  email                 String             @unique
  firebase_uid          String             @unique
  first_name            String?
  last_name             String?
  username              String?
  dob                   DateTime?          @db.Date
  gender                String?
  profile_picture       String?
  role                  String             @default("user")
  status                String             @default("pending")
  timezone              String?
  searchable            Boolean            @default(true)
  fcm_token             String?
  created_at            DateTime           @default(now())
  updated_at            DateTime           @default(now()) @updatedAt
  last_login_at         DateTime?
  communities_owned     Community[]
  community_memberships CommunityMembers[]

  posts      Post[]      
  post_views PostView[] 

  @@index([username])
  @@map("users")
}

model Community {
  id                Int                @id @default(autoincrement())
  name              String
  description       String?
  thumbnail         String?
  influencer        User               @relation(fields: [influencer_id], references: [id])
  influencer_id     Int
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  community_members CommunityMembers[]

  @@map("community")
}

model CommunityMembers {
  id           Int       @id @default(autoincrement())
  community    Community @relation(fields: [community_id], references: [id], onDelete: Cascade)
  community_id Int
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id      Int
  role         String    @default("member")
  status       String    @default("pending")
  joined_at    DateTime  @default(now())

  @@unique([community_id, user_id])
  @@map("community_members")
}

//activity
model Activity {
  id                Int       @id @default(autoincrement())
  name              String?
  description       String?
  category          String
  duration          Int?
  scheduledDatetime DateTime? @map("scheduled_datetime")
  status            String    @default("pending")
  post              Post?     @relation(fields: [postId], references: [id])
  postId            Int?      @map("post_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([scheduledDatetime])
  @@map("activities")
}

model Post {
  id          Int          @id @default(autoincrement())
  author      User         @relation(fields: [author_id], references: [id])
  author_id   Int
  caption     String?
  media_urls  Json?
  is_deleted  Boolean      @default(false)
  activities  Activity[]   
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  expires_at  DateTime?    // story类型设置24小时，chat类型为null

  post_targets PostTarget[]
  post_views   PostView[]

  @@map("posts")
  @@index([author_id, created_at])
  @@index([expires_at, is_deleted])
}

model PostTarget {
  id          Int      @id @default(autoincrement())
  post        Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id     Int
  target_type String   // 'community', 'chat', 'group'
  target_id   Int      
  created_at  DateTime @default(now())

  @@unique([post_id, target_type, target_id])
  @@index([target_type, target_id])
  @@map("post_targets")
}

model PostView {
  id         Int      @id @default(autoincrement())
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  post_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    Int
  viewed_at  DateTime @default(now())

  @@unique([post_id, user_id])
  @@index([user_id, viewed_at])
  @@map("post_views")
}