### Process Management Tests ###

# 1. Start the server with:
# npm run dev
#
# 2. Test graceful shutdown with different signals:
#    a. SIGTERM: kill -15 <PID>
#    b. SIGINT: Press Ctrl+C in terminal
#    c. SIGUSR2: kill -12 <PID>
#
# 3. Check logs for:
#    - Shutdown signal received
#    - Resource cleanup
#    - Server close
#    - Process exit
#
# 4. Verify database connections:
#    - Run health check before shutdown
#    - Try to make requests during shutdown
#    - Check database state after restart

### GraphQL User API Tests ###
@baseUrl = http://localhost:3000
@authToken = dev-token-123

### Mutation - Firebase Authentication login/create
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation { firebaseAuth { success user { id email firebase_uid first_name last_name role status } errors { field message } } }"
}


### Mutation - update User Profile
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation($input: UpdateUserInput!) { updateUser(input: $input) { success user { id first_name last_name username gender dob status } errors { field message } } }",
  "variables": {
    "input": {
      "first_name": "001",
      "last_name": "tester",
      "username": "test001",
      "gender": "male",
      "dob": "2024-01-02",
      "status": "active"
    }
  }
}

### Query - Get All Users
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "query { users { success users { id email firebase_uid first_name last_name username gender role status searchable last_login_at created_at updated_at } errors { field message } } }"
}

### Query - Get User by ID
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "query($id: Int!) { user(id: $id) { success user { id email firebase_uid first_name last_name username gender profile_picture role status timezone searchable last_login_at } errors { field message } } }",
  "variables": {
    "id": 1
  }
}


### Query - Get User by Firebase UID
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "query($firebase_uid: String!) { user(firebase_uid: $firebase_uid) { success user { id email firebase_uid first_name last_name username gender profile_picture role status timezone searchable last_login_at } errors { field message } } }",
  "variables": {
    "firebase_uid": "dev-test-001"
  }
}



### Query - Get Current User (Me)
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "query { me { success user { id email first_name last_name username status last_login_at } errors { field message } } }"
}


### Query - Get User Profile (Minimal Fields)
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "query { users { success users { id username email profile_picture } errors { field message } } }"
}

### Mutation - Delete User (Admin Only)
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation($id: Int!) { deleteUser(id: $id) { success errors { field message } } }",
  "variables": {
    "id": 1
  }
}

### Mutation - Deactivate Own Account
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation { deactivateAccount { success errors { field message } } }"
}
