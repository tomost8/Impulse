### Process Management Tests ###

# 1. Start the server with:
# npm run dev
#
# 2. Test graceful shutdown with different signals:
#    a. SIGTERM: kill -15 <PID>
#    b. SIGINT: Press Ctrl+C in terminal
#    c. SIGUSR2: kill -12 <PID>
#
# 3. Check logs for:
#    - Shutdown signal received
#    - Resource cleanup
#    - Server close
#    - Process exit
#
# 4. Verify database connections:
#    - Run health check before shutdown
#    - Try to make requests during shutdown
#    - Check database state after restart

### GraphQL User API Tests ###
@baseUrl = http://localhost:3000
@authToken = dev-token-123

### Mutation - Firebase Authentication login/create
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation { firebaseAuth { success user { id email firebase_uid first_name last_name role status } errors { field message } } }"
}


### Mutation - update User Profile
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation($input: UpdateUserInput!) { updateUser(input: $input) { success user { id first_name last_name username gender dob status } errors { field message } } }",
  "variables": {
    "input": {
      "first_name": "001",
      "last_name": "tester",
      "username": "test001",
      "gender": "male",
      "dob": "2024-01-02",
      "status": "active"
    }
  }
}

### Query - Get All Users
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "query { users { success users { id email firebase_uid first_name last_name username gender role status searchable last_login_at created_at updated_at } errors { field message } } }"
}

### Query - Get User by ID
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "query($id: Int!) { user(id: $id) { success user { id email firebase_uid first_name last_name username gender profile_picture role status timezone searchable last_login_at } errors { field message } } }",
  "variables": {
    "id": 1
  }
}


### Query - Get User by Firebase UID
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "query($firebase_uid: String!) { user(firebase_uid: $firebase_uid) { success user { id email firebase_uid first_name last_name username gender profile_picture role status timezone searchable last_login_at } errors { field message } } }",
  "variables": {
    "firebase_uid": "dev-test-001"
  }
}

### Query - Get Current User (Me)
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "query { me { success user { id email first_name last_name dob username status last_login_at } errors { field message } } }"
}


### Query - Get User Profile (Minimal Fields)
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "query { users { success users { id username email profile_picture } errors { field message } } }"
}

### Mutation - Delete User (Admin Only)
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation($id: Int!) { deleteUser(id: $id) { success errors { field message } } }",
  "variables": {
    "id": 1
  }
}

### Mutation - Deactivate Own Account
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation { deactivateAccount { success errors { field message } } }"
}

### Query - Get User Profile Info
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "query($id: Int!) { user(id: $id) { success user { username profile_picture} errors { field message } } }",
  "variables": {
    "id": 20
  }
}




### GraphQL Community API Tests ###

### Query - Get All Communities
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "query { communities { success communities { id name description thumbnail influencer { id first_name last_name email } influencer_id } errors { field message } } }"
}

### Query - Get Community by ID
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "query ($id: Int!) { community(id: $id) { success community { id name description thumbnail influencer { id first_name last_name email } influencer_id } errors { field message } } }",
  "variables": {
    "id": 7
  }
}

### Mutation - Create Community
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($input: CreateCommunityInput!) { createCommunity(input: $input) { success community { id name description thumbnail influencer { first_name last_name email } influencer_id } errors { field message } } }",
  "variables": {
    "input": {
      "name": "community name",
      "influencer_id": 1
    }
  }
}

### Mutation - Update Community
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($id: Int!, $input: UpdateCommunityInput!) { updateCommunity(id: $id, input: $input) { success community { id name description influencer { id first_name last_name email } influencer_id } errors { field message } } }",
  "variables": {
    "id": 3,
    "input": {
      "name": "community but with updated description",
      "description": "new description"
    }
  }
}

### Mutation - Delete Community
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation($id: Int!) { deleteCommunity(id: $id) { success errors { field message } } }",
  "variables": {
    "id": 6
  }
}


### GraphQL Community Member API Tests ###

### Mutation - Create Community Member
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($input: CreateCommunityMemberInput!) { createCommunityMember(input: $input) { success community_member { community { name influencer {first_name last_name } influencer_id } community_id user { first_name last_name } user_id } errors { field message } } }",
  "variables": {
    "input": {
      "community_id": 2,
      "user_id": 3
    }
  }
}

### Query - Get Community Members by Community ID
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "query ($communityId: Int!) { communityMembers(id: $communityId) {success community_members { user { first_name last_name } user_id role status } errors { field message } } }",
  "variables": {
    "communityId": 1
  }
}

### Query - Update community member role/status
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($communityId: Int!, $userId: Int!, $input: UpdateCommunityMemberInput!) { updateCommunityMember(community_id: $communityId, user_id: $userId, input: $input) { success community_member { community { name influencer { first_name last_name } influencer_id } community_id user { first_name last_name } user_id role status } errors { field message } } }",
  "variables": {
    "communityId": 1,
    "userId": 2,
    "input": {
      "role": "member",
      "status": "approved"
    }
  }
}

### Query - Delete member from community
POST http://localhost:3000/graphql
Content-Type: application/json

{
  "query": "mutation ($userId: Int!, $communityId: Int!) { deleteCommunityMember(user_id: $userId, community_id: $communityId) { success errors { field message } } }",  
  "variables": {
    "communityId": 2,
    "userId": 3
  }
}

### GraphQL Activity API Tests ###

### Query - Get All Activities
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "query($skip: Int, $take: Int, $category: String, $status: String) { activities(skip: $skip, take: $take, category: $category, status: $status) { success activities { id category status post { id author { id first_name last_name } } } errors { field message } } }",
  "variables": {
    "skip": 0,
    "take": 10,
    "category": "social",
    "status": "pending"
  }
}

### Query - Get Activity by ID
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "query($id: Int!) { activity(id: $id) { success activity { id category status post { id author { id first_name last_name } } } errors { field message } } }",
  "variables": {
    "id": 1
  }
}

### Mutation - Create Activity
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation($input: CreateActivityInput!) { createActivity(input: $input) { success activity { id category scheduledDatetime duration status post { id author { id first_name last_name } } } errors { field message } } }",
  "variables": {
    "input": {
      "category": "social",
      "scheduledDatetime": "2023-10-10T13:00:00Z",
      "duration": 60
    }
  }
}

### Mutation - Update Activity
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation($id: Int!, $input: UpdateActivityInput!) { updateActivity(id: $id, input: $input) { success activity { id category status post { id author { id first_name last_name } } } errors { field message } } }",
  "variables": {
    "id": 1,
    "input": {
      "category": "event",
      "status": "completed"
    }
  }
}

### Mutation - Delete Activity
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation($id: Int!) { deleteActivity(id: $id) { success activity { id category status } errors { field message } } }",
  "variables": {
    "id": 3
  }
}