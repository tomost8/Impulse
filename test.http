### Mutation - Firebase Authentication login/create
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation { firebaseAuth { success user { id email firebase_uid first_name last_name role status login_streak { streak_count weekly_logins } } errors { field message } } }"
}

POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation { firebaseAuth { success user { id email firebase_uid first_name last_name role status login_streak { streak_count weekly_logins } } errors { field message } } }"
}




### Mutation - update User Profile
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "mutation($input: UpdateUserInput!) { updateUser(input: $input) { success user { id first_name last_name username gender dob status } errors { field message } } }",
  "variables": {
    "input": {
      "first_name": "003",
      "last_name": "tester",
      "username": "test003",
      "gender": "male",
      "dob": "2024-01-02",
      "timezone": "America/New_York",
      "status": "active"
    }
  }
}


### Query - Get All Users
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "query { users { success users { id email firebase_uid first_name last_name username gender role status searchable last_login_at created_at updated_at } errors { field message } } }"
}

### Query - Get User by ID
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "query($id: Int!) { user(id: $id) { success user { id email firebase_uid first_name last_name username age gender bio primary_goal secondary_goal profile_picture role status timezone searchable last_login_at point { points spending_points weekly_points monthly_points } login_streak { streak_count weekly_logins formatted_weekly_logins { label completed } last_login_date } } errors { field message } } }",
  "variables": {
    "id": 1
  }
}


### Query - Get User by Firebase UID
POST {{baseUrl}}/graphql
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "query": "query($firebase_uid: String!) { user(firebase_uid: $firebase_uid) { success user { id email firebase_uid first_name last_name username age gender bio primary_goal secondary_goal profile_picture role status timezone searchable last_login_at point { points spending_points weekly_points monthly_points } login_streak { streak_count weekly_logins formatted_weekly_logins { label completed } last_login_date } } errors { field message } } }",
  "variables": {
    "firebase_uid": "dev-test-001"
  }
}

